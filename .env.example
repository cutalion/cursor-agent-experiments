# LiteLLM Master Key (Required)
# Generate a secure key for production: `openssl rand -hex 32`
LITELLM_MASTER_KEY=sk-dev-key

# Provider API Keys (Optional, depending on configured models)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Caddy Configuration (For Production)
DOMAIN=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
