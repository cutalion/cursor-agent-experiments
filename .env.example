# Copy to `.env` and adjust. Never commit real secrets.

# ------------------------------------------------------------------------------
# LiteLLM — required in production (`docker compose -f docker-compose.yml up`).
# Development: optional; override supplies a dev default if unset.
# ------------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-your-long-random-master-key

# Optional: comma-separated virtual keys for LiteLLM budgets / per-team keys
# (feature depends on LiteLLM version and optional database setup).
# LITELLM_API_KEYS=sk-team-a:team-a-budget-id,sk-team-b:team-b-budget-id

# ------------------------------------------------------------------------------
# Upstream providers — set only what you reference in litellm-config.yaml
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=

# ------------------------------------------------------------------------------
# Caddy — production TLS
# ------------------------------------------------------------------------------
# Public hostname for automatic Let’s Encrypt (omit / use localhost for local only)
CADDY_DOMAIN=localhost

# Required by Let’s Encrypt for real domains (defaults to internal@localhost in Caddyfile)
CADDY_EMAIL=

# ------------------------------------------------------------------------------
# Optional: LiteLLM salt for encrypting stored credentials (Postgres / UI features)
# LITELLM_SALT_KEY=
