# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit it.

# ── LiteLLM core ────────────────────────────────────────────────────────
# Master key — clients send this as `Authorization: Bearer <key>` (or
# Cosmetic prefix `sk-`). Generate one with `./scripts/gen-keys.sh`.
LITELLM_MASTER_KEY=sk-CHANGEME-master

# Salt key — used to encrypt virtual keys at rest in the DB. Required
# only when you enable the Postgres overlay, but harmless otherwise.
LITELLM_SALT_KEY=sk-CHANGEME-salt

# PRODUCTION | DEVELOPMENT — toggles a few defaults inside LiteLLM.
LITELLM_MODE=PRODUCTION
# DEBUG | INFO | WARNING | ERROR
LITELLM_LOG=INFO
# Persist admin-UI model edits to the DB. Requires DATABASE_URL.
STORE_MODEL_IN_DB=False

# ── Caddy / TLS ─────────────────────────────────────────────────────────
# Public domain Caddy will request a certificate for. Use a real DNS name
# in production; localhost-style values are fine for dev.
DOMAIN=litellm.localhost
# Email Let's Encrypt uses for renewal/revocation notices.
ACME_EMAIL=admin@example.com

# Optional gateway-level basic-auth (defense in depth). Leave both empty
# to disable. Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# ── Upstream provider keys ─────────────────────────────────────────────
# Only the providers you actually list in litellm-config.yaml need keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Optional: Postgres overlay ─────────────────────────────────────────
# Used by ./compose/postgres.yml. The connection string LiteLLM reads is
# DATABASE_URL — by default we point it at the in-network postgres
# service, but you can override with an external managed DB.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGEME-postgres-password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:CHANGEME-postgres-password@postgres:5432/litellm

# ── Optional: Redis overlay (caching, rate-limit storage) ──────────────
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
