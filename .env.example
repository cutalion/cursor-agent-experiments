# ---------- Core LiteLLM security ----------
LITELLM_MASTER_KEY=sk-your-strong-master-key
LITELLM_SALT_KEY=salt-your-strong-random-salt
OPENAI_API_KEY=sk-your-openai-key

# ---------- Optional local model provider ----------
OLLAMA_BASE_URL=http://ollama:11434

# ---------- Caddy ----------
GATEWAY_DOMAIN=ai.example.com
ACME_EMAIL=infra@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Caddy basic auth credentials
CADDY_BASICAUTH_USER=gateway
# Generate with: ./scripts/hash-password.sh "your-password"
CADDY_BASICAUTH_HASH=$2a$14$replace-this-bcrypt-hash
