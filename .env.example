# Copy to .env and replace every change-me value before production use.

# Public hostname for Caddy automatic HTTPS. Use localhost for local testing.
GATEWAY_DOMAIN=ai-gateway.example.com
ACME_EMAIL=ops@example.com
# Use 80 and 443 for production ACME. High ports avoid local dev conflicts.
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443
CADDY_DEV_PORT=8080

# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'replace-me'
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=replace-with-caddy-bcrypt-hash

# LiteLLM admin/API access. Master key must start with sk-.
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-secret
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me-to-a-long-random-password
LITELLM_HOST_PORT=4000
STORE_MODEL_IN_DB=True

# LiteLLM persistence.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-to-a-long-random-db-password
POSTGRES_DB=litellm

# Provider credentials. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TGI_API_BASE=http://tgi:8080

# Optional local model service.
OLLAMA_HOST_PORT=11434
