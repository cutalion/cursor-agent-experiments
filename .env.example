# ── Copy to .env and fill in real values ──────────────────────────────────────
# cp .env.example .env
# Never commit .env to version control.

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# A long random string used to authenticate admin requests and generate
# virtual API keys. Generate one with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-use-openssl-rand-hex-32

# ── Caddy (production only) ──────────────────────────────────────────────────
# The public domain Caddy will request a TLS certificate for.
CADDY_DOMAIN=llm.example.com
# Email used for Let's Encrypt renewal notifications.
CADDY_ADMIN_EMAIL=admin@example.com

# ── AI Provider Keys ─────────────────────────────────────────────────────────
# Add only the providers you actually use. Unused variables are ignored.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Azure OpenAI (if using azure/* models)
AZURE_API_KEY=
AZURE_API_BASE=https://<resource>.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# ── Optional: Persistent storage ─────────────────────────────────────────────
# Postgres — enables virtual key management, spend tracking, and audit logs.
# DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm

# Redis — enables rate limiting and caching across multiple LiteLLM replicas.
# REDIS_URL=redis://redis:6379

# ── Observability (optional callbacks) ───────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
