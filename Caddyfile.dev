# Development Caddyfile — plain HTTP on :8080.
# Use http://localhost:8080 from the host. Inside the compose network,
# clients should keep talking to litellm:4000 directly.
{
	auto_https off
	admin off
}

:8080 {
	encode gzip

	log {
		output stdout
		format console
		level DEBUG
	}

	reverse_proxy litellm:4000 {
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
